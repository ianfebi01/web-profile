{
    "[typescriptreact]": {
      "editor.formatOnSave": false,
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
      "editor.formatOnSave": false,
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascript]": {
      "editor.formatOnSave": false,
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "eslint.validate": [
      "javascript",
      "javascriptreact",
      "html",
      "typescriptreact",
      "typescript"
    ],
    "nuxt.isNuxtApp": false,
    // The bundled PostCSS validator predates CSS cascade layers, so it flags
    // valid `@import '...' layer(...)` (required by Tailwind v4) as errors.
    "postcss.validate": false,
    "css.lint.unknownAtRules": "ignore",
    "eslint.useFlatConfig": true
  }
  